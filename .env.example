# Copy to `.env` for local development, and add the same three variables in
# Vercel → Project → Settings → Environment Variables for production.
# These are read on the server only — never prefix them with VITE_.

# Brevo → SMTP & API → API Keys (starts with "xkeysib-")
BREVO_API_KEY=

# Sender address. Must be verified in Brevo → Senders, Domains & Dedicated IPs.
EMAIL_USER=serenityhavensupport@gmail.com

# Inbox that receives new enquiries from the contact form.
RECIPIENT_EMAIL=serenityhavensupport@gmail.com
